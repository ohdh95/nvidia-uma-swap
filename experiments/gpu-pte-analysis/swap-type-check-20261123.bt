#!/usr/bin/env bpftrace

// Read-only snapshot for kernel 7.0.0-1019-nvidia on this machine.
// MAX_SWAPFILES = 32 - 3 (device) - 3 (migration) - 1 (hwpoison)
//                   - 1 (PTE marker) = 24, from the installed kernel config.
// The filter matches /proc/swaps: SWP_USED is set and swap_map is non-NULL.
// name is the basename of the backing file, not its full path.

BEGIN
{
    $table = kaddr("swap_info");
    $index = 0;
    $active = 0;

    while ($index < 24) {
        $info = (struct swap_info_struct *)*(uint64 *)($table + $index * 8);
        if ($info != 0) {
            if (($info->flags & 1) != 0 && $info->swap_map != 0) {
                printf("type=%d name=%s pages=%u priority=%d\n",
                       $info->type,
                       str($info->swap_file->f_path.dentry->d_name.name),
                       $info->pages,
                       $info->prio);
                $active++;
            }
        }
        $index++;
    }

    printf("active_count=%d\n", $active);
    exit();
}
